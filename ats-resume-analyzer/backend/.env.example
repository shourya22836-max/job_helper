# ----------------------------------------------------------------------------- #
# AI Resume Assistant — backend env
# ----------------------------------------------------------------------------- #

# OpenRouter API key — get one at https://openrouter.ai/keys
# (OpenRouter is OpenAI-compatible, so it works with the OpenAI Python SDK)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: choose any model from https://openrouter.ai/models
# Examples:
#   openai/gpt-4o-mini          (cheap, fast, recommended)
#   anthropic/claude-3.5-sonnet
#   google/gemini-2.0-flash-exp
#   meta-llama/llama-3.3-70b-instruct
OPENAI_MODEL=openai/gpt-4o-mini

# Optional: OpenRouter uses these for app attribution (safe to leave blank)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ATS Resume Analyzer

# ----------------------------------------------------------------------------- #
# LiveKit (free tier: https://cloud.livekit.io) — required for the Interview page.
# LIVEKIT_URL must be a wss:// URL; the token is signed with the API key/secret below.
# ----------------------------------------------------------------------------- #
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxx
LIVEKIT_API_SECRET=secretxxx

# ----------------------------------------------------------------------------- #
# LiveKit Agents worker (backend/agent.py) — realtime voice pipeline.
# Run separately: `python agent.py dev`
# ----------------------------------------------------------------------------- #
# Deepgram (free tier: https://console.deepgram.com) — STT for the agent.
DEEPGRAM_API_KEY=

# Cartesia (https://cartesia.ai) — TTS for the agent.
# Optional: if empty, the agent runs in captions-only mode (transcripts stream, no audio).
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=794f9389-aac1-45b6-b726-9d9369183238

# (Optional) override the LiveKit URL the agent worker connects to.
# Defaults to LIVEKIT_URL above.
# LIVEKIT_AGENT_URL=wss://your-project.livekit.cloud

# ----------------------------------------------------------------------------- #
# TTS Provider Abstraction — backend-only secrets
# Choose ONE provider: cartesia, elevenlabs, deepgram_aura, openai
# ----------------------------------------------------------------------------- #
# RECOMMENDED: Deepgram Aura 2 — natural, low-latency, great for interviews
# TTS_PROVIDER=deepgram_aura
# TTS_API_KEY=your_deepgram_key_here
# TTS_VOICE_ID=aura-2-thalia-en     # Female, warm, professional (recommended for interviewer)
# TTS_VOICE_ID=aura-2-zeus-en       # Male, deep, authoritative
# TTS_VOICE_ID=aura-2-asteria-en    # Female, friendly, conversational
# TTS_VOICE_ID=aura-2-hermes-en     # Male, articulate, professional
# TTS_MODEL=aura-2-thalia-en        # Model = voice ID for Deepgram Aura
# TTS_SAMPLE_RATE=24000

# ALTERNATIVE: ElevenLabs v2 / Turbo — premium quality, more expressive
# TTS_PROVIDER=elevenlabs
# TTS_API_KEY=your_elevenlabs_key_here
# TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel (female, professional)
# TTS_VOICE_ID=pNInz6obpgDQGcFmaJgB   # Adam (male, deep)
# TTS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # Sarah (female, warm)
# TTS_VOICE_ID=VR6AewLTigWG4xSOukaG   # Arnold (male, authoritative)
# TTS_MODEL=eleven_turbo_v2_5         # Low-latency turbo model
# TTS_SAMPLE_RATE=24000

# ALTERNATIVE: Cartesia Sonic-2 — fast, good quality
# TTS_PROVIDER=cartesia
# TTS_API_KEY=your_cartesia_key_here
# TTS_VOICE_ID=794f9389-aac1-45b6-b726-9d9369183238  # Default female
# TTS_MODEL=sonic-2
# TTS_SAMPLE_RATE=24000

# ALTERNATIVE: OpenAI TTS — simple, reliable
# TTS_PROVIDER=openai
# TTS_API_KEY=your_openai_key_here
# TTS_VOICE_ID=alloy                 # alloy, echo, fable, onyx, nova, shimmer
# TTS_MODEL=tts-1-hd                 # tts-1 or tts-1-hd
# TTS_SAMPLE_RATE=24000

# Active config (uncomment one provider above and fill in keys):
TTS_PROVIDER=deepgram_aura
TTS_API_KEY=
TTS_VOICE_ID=aura-2-thalia-en
TTS_MODEL=aura-2-thalia-en
TTS_SAMPLE_RATE=24000

# ----------------------------------------------------------------------------- #
# Avatar Provider Abstraction — backend-only secrets
# Choose ONE provider: local, tavus, heygen, beyond_presence, simli
# ----------------------------------------------------------------------------- #
AVATAR_PROVIDER=local          # local | tavus | heygen | beyond_presence | simli

# Tavus (https://tavus.io) — Conversational Video Rendering
TAVUS_API_KEY=
TAVUS_REPLICA_ID=

# HeyGen (https://heygen.com) — Streaming Avatar
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=

# Beyond Presence (https://beyondpresence.ai)
BEYOND_PRESENCE_API_KEY=
BEYOND_PRESENCE_AGENT_ID=

# Simli (https://simli.ai) — Low-latency WebRTC avatar
SIMLI_API_KEY=
SIMLI_FACE_ID=

# Local 3D fallback (React Three Fiber) — no API key needed
# Optional: custom GLB model URL with ARKit blendshapes
LOCAL_AVATAR_MODEL_URL=https://threejs.org/examples/models/gltf/RobotExpressive/RobotExpressive.glb